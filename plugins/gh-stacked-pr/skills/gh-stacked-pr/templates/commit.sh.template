#!/usr/bin/env bash
# Stack script for reference: <reference>
# Generated by the gh-stacked-pr skill. Review before running.
#
# Dry-run is the default to preview commands without executing them.
# Requires --run to execute commands that change files and git state.
#
# Usage:
#   ./commit.sh           # Preview commands without executing (dry-run default)
#   ./commit.sh --run     # Execute git and gh commands
#
# Non-interactive by design:
# - every gh stack command gets an explicit branch or flag
# - gh stack submit --auto skips the PR editor
# - add --open to submit if the PRs must be ready for review

set -euo pipefail

DRY_RUN=true
while [ $# -gt 0 ]; do
  case "$1" in
    --run|-r)
      DRY_RUN=false
      shift
      ;;
    --dry-run|-n)
      DRY_RUN=true
      shift
      ;;
    -h|--help)
      echo "Usage: $0 [--run] [--dry-run]"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      echo "Usage: $0 [--run] [--dry-run]" >&2
      exit 1
      ;;
  esac
done

run() {
  if [ "$DRY_RUN" = true ]; then
    echo "[dry-run] $*"
  else
    "$@"
  fi
}

cd "$(git rev-parse --show-toplevel)"

# If the repository has more than one remote, uncomment:
# run git config remote.pushDefault origin

# --- Layer 1: <reference>-1-<topic> ---------------------------------------
run gh stack init "<reference>-1-<topic>"
run git add "<path>" "<path>"
run git commit -m "<type>(<scope>): <summary>" \
  -m "<body>

Depends on: none."

# --- Layer 2: <reference>-2-<topic> ---------------------------------------
run gh stack add "<reference>-2-<topic>"
run git add "<path>" "<path>"
run git commit -m "<type>(<scope>): <summary>" \
  -m "<body>

Depends on: <reference>-1-<topic> (<what it provides>)."

# --- Layer N: repeat the add/add/commit block per layer --------------------

# --- Submit: push all branches and open PRs -------------------------------
# Draft PRs:
run gh stack submit --auto
# Ready for review instead:
# run gh stack submit --auto --open

# --- PR titles and bodies --------------------------------------------------
# gh stack submit --auto generates titles. Set the real ones afterwards.
# Find the PR numbers with: gh stack view --json
run gh pr edit <pr-number> --title "<type>(<scope>): <summary>" --body "$(cat <<'EOF'
## Summary

<short text plus a diff sketch, file tree, or pseudocode>

## Evidence

- **Before:** <failing test, error output, or screenshot>
  **After:** <passing test, fixed output, or screenshot>

## Merge Danger

**Door:** <one-way or two-way>

**Blast Radius:** <one word>

Depends on: <branch or PR below this one>.
EOF
)"

# --- Verify ----------------------------------------------------------------
run gh stack view --json
